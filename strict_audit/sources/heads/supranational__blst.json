[{"sha":"cf7f2e372bc7ff76fa99dd1ee1b4085d2aeee6f1","node_id":"C_kwDOEFeUd9oAKGNmN2YyZTM3MmJjN2ZmNzZmYTk5ZGQxZWUxYjQwODVkMmFlZWU2ZjE","commit":{"author":{"name":"Andy Polyakov","email":"appro@cryptogams.org","date":"2026-11-06T17:54:21Z"},"committer":{"name":"Andy Polyakov","email":"appro@cryptogams.org","date":"2026-11-06T17:54:21Z"},"message":"bindings/rust/src/pippenger.rs: resolve BorrowSanitizer misgivings.\n\nConcern is that the compiler may generate code prone to out-of-order loads\nand stores. However, the allegedly susceptible operations are enclosed by\natomic operations that the compiler is not allowed to reorder, which\neffectively guarantees the proper ordering.\n\nFixes #302, #303.","tree":{"sha":"2d81d4200f0556d1256bae0dc2a8eb3aa03bdfb8","url":"https://api.github.com/repos/supranational/blst/git/trees/2d81d4200f0556d1256bae0dc2a8eb3aa03bdfb8"},"url":"https://api.github.com/repos/supranational/blst/git/commits/cf7f2e372bc7ff76fa99dd1ee1b4085d2aeee6f1","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/supranational/blst/commits/cf7f2e372bc7ff76fa99dd1ee1b4085d2aeee6f1","html_url":"https://github.com/supranational/blst/commit/cf7f2e372bc7ff76fa99dd1ee1b4085d2aeee6f1","comments_url":"https://api.github.com/repos/supranational/blst/commits/cf7f2e372bc7ff76fa99dd1ee1b4085d2aeee6f1/comments","author":{"login":"dot-asm","id":9038069,"node_id":"MDQ6VXNlcjkwMzgwNjk=","avatar_url":"https://avatars.githubusercontent.com/u/9038069?v=4","gravatar_id":"","url":"https://api.github.com/users/dot-asm","html_url":"https://github.com/dot-asm","followers_url":"https://api.github.com/users/dot-asm/followers","following_url":"https://api.github.com/users/dot-asm/following{/other_user}","gists_url":"https://api.github.com/users/dot-asm/gists{/gist_id}","starred_url":"https://api.github.com/users/dot-asm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.c