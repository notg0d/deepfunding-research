[{"sha":"6a9bca7e7b27d1af853620a806a216f7560b62d1","node_id":"C_kwDOLOaYINoAKDZhOWJjYTdlN2IyN2QxYWY4NTM2MjBhODA2YTIxNmY3NTYwYjYyZDE","commit":{"author":{"name":"Frank Laub","email":"frank@risczero.com","date":"2026-11-11T03:09:54Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-11-11T03:09:54Z"},"message":"deployment.toml: drop Polygon zkEVM mainnet (#750)\n\nRemoves the `polygon-zkevm-mainnet` section from\n`contracts/deployment.toml`.\n\nPolygon zkEVM mainnet stopped producing blocks on 2026-07-03 (the\nPolygon zkEVM sunset), so its router, verifiers and estops can no longer\nbe called or changed, and it gets no 3.1.0 verifier. The section had\nbeen kept with `halted = true` as a final record; the git history keeps\nthat record now. Nothing in the scripts or the deployment test\nreferenced it after 686eae6 dropped it from the chain loops.\n\nThe older versioned verifier pages on the docs site keep their Polygon\nzkEVM addresses as historical records.\n\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","tree":{"sha":"26d15eced4659c77c6487b8202233bafb49509c1","url":"https://api.github.com/repos/risc0/risc0-ethereum/git/trees/26d15eced4659c77c6487b8202233bafb49509c1"},"url":"https://api.github.com/repos/risc0/risc0-ethereum/git/commits/6a9bca7e7b27d1af853620a806a216f7560b62d1","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJq89yCCRC1aQ7uu5UhlAAA7/cQADN0cq3JkXxhmd3yrBlJfZ2m\nDwZ94NH9hxgLpNtb+KcGsQpCOBTQLc3zHEYEkWhj8ViXKZIImdJcSLzsZIX9AO/o\nxNAH05AyV88Vlqe39fIuNxVz2eNDyWlHK6T6clQhff6+VkabQ0A7THpSZ+LiNbft\ngdXj5WyrhYOEoMe1msRx0ueBaYzf53KKzQc+OiOhefnqEXyW8yCSMY94NmLSbrfb\nGpS8HtIS+vx+d96AH+eyUGwolcYlvp1O6QBBr8n/LL7e33sFEAljtfALh5cUO6gN\nflyhqsK0d9VAFir9MO7QYYZY5CmPEopCBspWVAEwXffLP7DHmQ6YAo11rO0brJBD\nG2nnG7iVIk0H8/+C9XJcHn5DgalZg7oYMiRkLj5HY7Spx+vTcQERuM5qhIsZrhLP\n4h98rne0c+i1AlagWlX7DYFb+qwLbStYgM4DbRvCBQ9vZO50JleaAbNN0t9wJ+lU\nQxjEnaYD+2OpaGbLU071FdZX89PQtmT6qQQFS7bod9vI33NOa5BTWJEtdP9VNdVR\nftsGsEAaq3ygNyTfhZjoUnIiYZF0XsJjogKVE5UVv+MPiA2npIRGMmYn3YUD62is\n9aKft6O5qXKriNFV8TTpBUpsnJGXRioK1GWgYUGY6xcHkng1L2mDEcD2KN4gT3vX\ne8vage6V/6ZEhXo6mwCy\n=4suu\n-----END PGP SIGNATURE-----\n","payload":"tree 26d15eced4659c77c6487b8202233bafb49509c1\nparent 0aeacadf407adb883660bbfad95735f8afb63e92\nauthor Frank Laub <frank@risczero.com> 1794366594 -0800\ncommitter GitHub <noreply@github.com> 1794366594 -0800\n\ndeployment.toml: drop Polygon zkEVM mainnet (#750)\n\nRemoves the `polygon-zkevm-mainnet` section from\n`contracts/deployment.toml`.\n\nPolygon zkEVM mainnet stopped producing blocks on 2026-07-03 (the\nPolygon zkEVM sunset), so its router, verifiers and estops can no longer\nbe called or changed, and it gets no 3.1.0 verifier. The section had\nbeen kept with `halted = true` as a final record; the git history keeps\nthat record now. Nothing in the scripts or the deployment test\nreferenced it after 686eae6 dropped it from the chain loops.\n\nThe older versioned verifier pages on the docs site keep their Polygon\nzkEVM addresses as historical records.\n\nCo-authored-by: Claude Opus 5.5 <noreply@anthropic.com>","verified_at":"2026-11-11T03:09:55Z"}},"url":"https://api.github.com/repos/risc0/risc0-ethereum/commits/6a9bca7e7b27d1af853620a806a216f7560b62d1","html_url":"https://github.com/risc0/risc0-ethereum/commit/6a9bca7e7b27d1af853620a806a216f7560b62d1","comments_url":"https://api.github.com/repos/risc0/risc0-ethereum/commits/6a9bca7e7b27d1af853620a806a216f7560b62d1/comments","author":{"login":"flaub","id":111859,"node_id":"MDQ6VXNlcjExMTg1OQ==","avatar_url":"https://avatars.githubusercontent.com/u/111859?v=4","gravatar_id":"","url":"https://api.github.com/users/flaub","html_url":"https://github.com/flaub","followers_url":"https://api.github.com/users/flaub/followers","following_url":"https://api.github.com/users/flaub/following{/other_user}","gists_url":"https://api.github.com/users/flaub/gists{/gist_id}","starred_url":"http